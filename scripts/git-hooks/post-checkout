#!/usr/bin/env bash
# Post-checkout: after a branch switch, rebuild the minified JavaScript when a source is newer than its .min.js
# (scripts/lib/js-build.sh), so the site (DEBUG_MODE = false) serves the checked-out branch's scripts.
#
# Runs only on branch checkouts (third argument 1), not on file checkouts. Prints one line when it rebuilds and
# nothing otherwise; stays silent when node_modules is missing (scripts/test.sh reports that). A failed build only
# warns: the checkout itself has already happened and is never blocked.

[ "${3:-0}" = 1 ] || exit 0

. "$(dirname "$0")/../lib/js-build.sh"

[ -d assets/js ] && [ -x node_modules/.bin/gulp ] || exit 0

stale=$(js_stale_scripts | wc -l)
[ "$stale" -gt 0 ] || exit 0

echo "post-checkout: JS-Build (npx gulp scripts) für $stale veraltete Quelle(n)"
if ! npx gulp scripts >/dev/null 2>&1; then
    echo "post-checkout: Warnung – npx gulp scripts fehlgeschlagen, die Seite liefert altes JS (manuell: npx gulp scripts)" >&2
fi

exit 0
